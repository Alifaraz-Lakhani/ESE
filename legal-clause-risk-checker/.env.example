# Copy this file to .env and fill in your API keys before running the app.

# LLM providers (at least one recommended)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Hugging Face (only needed for QLoRA training / pushing adapters)
HF_HUB_REPO_ID=your-org/legal-clause-risk-lora
HF_TOKEN=hf_...

# ChromaDB persistence directory (defaults to .chroma under the project root)
# CHROMA_PERSIST_DIR=.chroma
